# ─── Frontend routing (REQUIRED) ─────────────────────────────────────────────
#
# Controls where lib/api.ts sends API requests:
#
# MODE A — Local dev → local FastAPI
#   NEXT_PUBLIC_PO_LICE_API_URL=
#   PO_LICE_BACKEND_URL=http://127.0.0.1:8000
#   (empty NEXT_PUBLIC means relative /api/v1/* paths → Next.js proxy → backend)
#
# MODE B — Local dev → deployed Render backend (no local uvicorn needed)
#   NEXT_PUBLIC_PO_LICE_API_URL=https://po-lice-backend-staging-qiix.onrender.com
#   PO_LICE_BACKEND_URL=https://po-lice-backend-staging-qiix.onrender.com
#
# MODE C — Vercel → Render (set BOTH in the Vercel dashboard env vars section)
#   NEXT_PUBLIC_PO_LICE_API_URL=https://po-lice-backend-staging-qiix.onrender.com
#   PO_LICE_BACKEND_URL=https://po-lice-backend-staging-qiix.onrender.com
#
# CORS note: In Mode B/C, browser fetches go directly to Render, so
# PO_LICE_ALLOWED_ORIGINS on Render MUST include your Vercel domain.
NEXT_PUBLIC_PO_LICE_API_URL=
PO_LICE_BACKEND_URL=http://127.0.0.1:8000

# ─── Backend core ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins for CORS. Include all Vercel domains.
# Example: https://kaya-ai-police.vercel.app,https://kaya-ai-police-git-main-team.vercel.app
PO_LICE_ALLOWED_ORIGINS=http://localhost:3000

PO_LICE_PROJECT_ID=PRJ-AMBER-01
PO_LICE_DATA_DIR=backend/data

# Enable demo-mode persistence (SQLite + local filesystem).
DEMO_MODE=true

# PostgreSQL / Supabase (leave blank to use SQLite demo mode)
SUPABASE_DATABASE_URL=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_REQUEST_TIMEOUT_SECONDS=10

# ─── Local model extraction (disabled by default) ─────────────────────────────
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_FALLBACK_MODEL=
ML_EXTRACTION_DEADLINE_SECONDS=20

# ─── Remote extraction via Gemini (disabled by default; keys stay server-side) ─
REMOTE_EXTRACTION_ENABLED=false
REMOTE_EXTRACTION_PROJECTS=
GEMINI_MODEL=
GEMINI_API_KEY=

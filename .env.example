# Production should use a tile provider and OSRM-compatible routing service sized
# for the application's traffic. The public defaults are intended for demos only.
NEXT_PUBLIC_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_OSM_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
NEXT_PUBLIC_OSRM_ROUTE_URL=https://router.project-osrm.org
